{
  "target_url": "https://sec.rajasthan.gov.in/GramPanchayatDetails.aspx",
  "election_type_value": "1",
  "election_type_label": "General Election",
  "election_period_value": "64",
  "election_period_label": "OCT-NOV 2026",
  "amber_excel_path": "Sarpanch Result (AMBER) New.xlsx",
