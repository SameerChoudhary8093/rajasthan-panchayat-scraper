    "progress_csv": "output/progress.csv",
    "combined_excel": "output/Rajasthan_Sarpanch_Contesting_Candidates_Combined.xlsx",
    "error_report_csv": "output/error_and_missing_report.csv",
    "error_report_md": "output/error_and_missing_report.md",
